package com.yourproject.backend.services;

import com.yourproject.backend.models.Appointment;
import com.yourproject.backend.repositories.AppointmentRepository;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;
import jakarta.persistence.EntityNotFoundException;
import java.time.LocalDateTime;
import java.util.List;
import java.util.Optional;

/**
 * Service class handling business logic for Appointment management.
 */
@Service
public class AppointmentService {

    private final AppointmentRepository appointmentRepository;

    @Autowired
    public AppointmentService(AppointmentRepository appointmentRepository) {
        this.appointmentRepository = appointmentRepository;
    }

    /**
     * Retrieves all appointments.
     * @return A list of all Appointment objects.
     */
    @Transactional(readOnly = true)
    public List<Appointment> findAllAppointments() {
        return appointmentRepository.findAll();
    }

    /**
     * Retrieves an appointment by its ID.
     * @param id The ID of the appointment to find.
     * @return An Optional containing the Appointment, or empty if not found.
     */
    @Transactional(readOnly = true)
    public Optional<Appointment> findAppointmentById(Long id) {
        return appointmentRepository.findById(id);
    }

    /**
     * Saves or creates a new appointment with availability check.
     * @param appointment The Appointment object to save.
     * @return The saved Appointment object.
     * @throws IllegalArgumentException if appointment or doctor is null.
     * @throws IllegalStateException if the appointment slot is already taken.
     */
    @Transactional
    public Appointment saveAppointment(Appointment appointment) {
        if (appointment == null || appointment.getDoctor() == null) {
            throw new IllegalArgumentException("Appointment or Doctor cannot be null");
        }
        if (isAppointmentSlotAvailable(appointment.getDoctor().getId(), appointment.getAppointmentTime())) {
            return appointmentRepository.save(appointment);
        } else {
            throw new IllegalStateException("The selected appointment slot is already taken.");
        }
    }

    /**
     * Updates an existing appointment's details with availability check.
     * @param id The ID of the appointment to update.
     * @param appointmentDetails The updated Appointment object.
     * @return The updated Appointment object.
     * @throws EntityNotFoundException if the appointment is not found.
     * @throws IllegalStateException if the new time conflicts with existing slots.
     */
    @Transactional
    public Appointment updateAppointment(Long id, Appointment appointmentDetails) {
        Appointment existingAppointment = appointmentRepository.findById(id)
                .orElseThrow(() -> new EntityNotFoundException("Appointment not found with id: " + id));
        if (!isAppointmentSlotAvailable(existingAppointment.getDoctor().getId(), appointmentDetails.getAppointmentTime())) {
            throw new IllegalStateException("The new appointment time conflicts with existing slots.");
        }
        existingAppointment.setAppointmentTime(appointmentDetails.getAppointmentTime());
        existingAppointment.setNotes(appointmentDetails.getNotes());
        existingAppointment.setStatus(appointmentDetails.getStatus());
        existingAppointment.setPatient(appointmentDetails.getPatient());
        existingAppointment.setDoctor(appointmentDetails.getDoctor());
        return appointmentRepository.save(existingAppointment);
    }

    /**
     * Deletes an appointment by its ID.
     * @param id The ID of the appointment to delete.
     * @throws EntityNotFoundException if the appointment is not found.
     */
    @Transactional
    public void deleteAppointment(Long id) {
        if (!appointmentRepository.existsById(id)) {
            throw new EntityNotFoundException("Appointment not found with id: " + id);
        }
        appointmentRepository.deleteById(id);
    }

    /**
     * Checks if an appointment slot is available for a given doctor and time.
     * Considers a 30-minute buffer to avoid overlapping appointments.
     * @param doctorId The ID of the doctor.
     * @param appointmentTime The proposed appointment time.
     * @return true if the slot is available, false otherwise.
     */
    public boolean isAppointmentSlotAvailable(Long doctorId, LocalDateTime appointmentTime) {
        if (doctorId == null || appointmentTime == null) return false;
        LocalDateTime startBuffer = appointmentTime.minusMinutes(30);
        LocalDateTime endBuffer = appointmentTime.plusMinutes(30);
        List<Appointment> conflictingAppointments = appointmentRepository
                .findByDoctorIdAndAppointmentTimeBetween(doctorId, startBuffer, endBuffer);
        return conflictingAppointments.stream()
                .noneMatch(a -> !a.getId().equals(appointment.getId())); // Ignore current appointment if updating
    }

    /**
     * Finds all appointments for a specific doctor.
     * @param doctorId The ID of the doctor.
     * @return A list of Appointment objects.
     */
    @Transactional(readOnly = true)
    public List<Appointment> findAppointmentsByDoctor(Long doctorId) {
        return appointmentRepository.findByDoctorId(doctorId);
    }

    /**
     * Finds upcoming appointments for a specific patient.
     * @param patientId The ID of the patient.
     * @return A list of Appointment objects.
     */
    @Transactional(readOnly = true)
    public List<Appointment> findUpcomingAppointments(Long patientId) {
        LocalDateTime now = LocalDateTime.now();
        return appointmentRepository.findByPatientIdAndAppointmentTimeAfter(patientId, now);
    }
}
